# ============================================
# MOLFI ENVIRONMENT VARIABLES
# ============================================
# Copy this to .env and fill in your values.

# ============================================
# STELLAR / SOROBAN
# ============================================
# Network: "testnet" (default) or "mainnet"
VITE_STELLAR_NETWORK="testnet"
# Soroban RPC endpoint
VITE_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
# Horizon endpoint (classic ops, account funding)
VITE_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
# Molfi matching/CLOB API (off-chain orderbook)
VITE_MOLFI_API_URL="https://api.molfi.fun"

# Deployed Soroban contract IDs (filled in during Phase 2/3)
VITE_MARKET_CONTRACT_ID=""
VITE_CLOB_SETTLEMENT_CONTRACT_ID=""
VITE_PRIVACY_POOL_CONTRACT_ID=""
VITE_VERIFIER_CONTRACT_ID=""
# Collateral asset (SAC contract id for test USDC)
VITE_COLLATERAL_SAC_ID=""

# ============================================
# SUPABASE (YOUR OWN INSTANCE)
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."

# ============================================
# VENUE API KEYS (optional — multi-venue aggregation)
# ============================================
# Polymarket CLOB API
POLYMARKET_API_KEY=""
# Limitless API
LIMITLESS_API_KEY=""
