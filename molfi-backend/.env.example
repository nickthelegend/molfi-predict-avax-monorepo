# Molfi backend — copy to .env and fill in your own values. NEVER commit .env.

# MongoDB connection string (required to run the server; tests use an in-memory
# MongoDB and do NOT need this).
MONGODB_URI=mongodb://localhost:27017

# REST API port
PORT=4000

# Avalanche Fuji C-Chain (read-only; the backend never broadcasts transactions)
MOLFI_RPC=https://api.avax-test.network/ext/bc/C/rpc
MOLFI_CHAIN_ID=43113

# Deployed Molfi contracts on Fuji (defaults baked in; override for a fresh deploy)
MOLFI_MARKET=0xBded9535cbe128f09A8CC1a97dDFb339f22CBc9b
MOLFI_ESCROW=0xfe00776f7EFc1208F2B89A34d6Acd408a0410c9c
MOLFI_CBET=0x5DAFB4217088dFB79dee6d780ED7437DC9D42E84
MOLFI_MUSDC=0xADE818616EA14903278E9cE11c2BfFfa4eEB682C
MOLFI_VERIFIER=0xCA791da6e0e2DB1C5B36Eb297B2d7bE05dc01EBB

# Chainlink AggregatorV3 price feeds (Fuji, 8 decimals) — override if needed
FEED_BTC=0x31CF013A08c6Ac228C94551d535d5BAfE19c602a
FEED_ETH=0x86d67c3D38D2bCeE722E601025C25a575021c6EA
FEED_AVAX=0x5498BB86BC934c8D34FDA08E81D444153d0D06aD
FEED_LINK=0x34C4c526902d88a3Aa98DB8a9b802603EB1E3470

# Compiled BN254 confidential_bet circuit dir (defaults to ../molfi-circuits/build/confidential_bet)
# MOLFI_CONF_CIRCUIT=

# Optional: Pinata IPFS pinning for market-chat image uploads
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
